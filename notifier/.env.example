# HTTP listen
PORT=8787
HOST=127.0.0.1

# Shared secret required on register/unregister (app sends as X-Basic-Notifier-Key).
# Generate: openssl rand -hex 32
NOTIFIER_APP_KEY=replace-with-long-random-secret

# Home relay for gift-wrap watch (sidecar default)
HOME_RELAY=wss://relay.davidcoen.it

# Firebase / FCM HTTP v1 — path to service account JSON (never commit the real file)
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
# Or paste JSON (dev only):
# FCM_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Optional: override Android package / collapse key
FCM_ANDROID_PACKAGE=app.basic.wallet

# Registration store (JSON file)
STORE_PATH=/var/lib/basic-notifier/registrations.json

# Coalesce window: at most one tray ping per npub in this many ms
COALESCE_MS=5000

# Rate limit: max register calls per IP per minute
REGISTER_RATE_PER_MIN=30
