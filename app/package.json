{
  "name": "basic-wallet",
  "version": "0.8.3-chatwithai",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "check:catch-up-credit": "npx tsx scripts/check-catch-up-credit.ts",
    "check:post-send-balance": "npx tsx scripts/check-post-send-balance-guard.ts",
    "check:activity-refresh": "npx tsx scripts/check-activity-refresh.ts",
    "check:chat-pay-settle": "npx tsx scripts/check-chat-pay-settle.ts",
    "check:false-inbound-rollback": "npx tsx scripts/check-false-inbound-rollback.ts",
    "check:wallet-guards": "npm run check:catch-up-credit && npm run check:post-send-balance && npm run check:activity-refresh && npm run check:chat-pay-settle && npm run check:false-inbound-rollback",
    "prebuild:android": "expo prebuild --platform android --clean"
  },
  "dependencies": {
    "@arkade-os/sdk": "^0.5.0-rc.10",
    "@arkade-os/swap": "^0.1.0-rc.13",
    "@noble/ciphers": "^1.3.0",
    "@noble/hashes": "^1.8.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.1",
    "@scure/base": "^1.2.6",
    "@scure/bip39": "^2.4.0",
    "expo": "~57.0.22",
    "expo-blur": "~57.0.3",
    "expo-build-properties": "~57.0.20",
    "expo-camera": "~57.0.5",
    "expo-clipboard": "~57.0.2",
    "expo-crypto": "~57.0.3",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-local-authentication": "~57.0.3",
    "expo-notifications": "~57.0.21",
    "expo-screen-capture": "~57.0.3",
    "expo-secure-store": "~57.0.4",
    "expo-sensors": "~57.0.3",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "nostr-tools": "^2.25.2",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-ble-plx": "^3.5.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-passkeys": "^0.4.2",
    "react-native-qrcode-svg": "^6.3.24",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.5",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.0",
    "typescript": "~5.9.2"
  }
